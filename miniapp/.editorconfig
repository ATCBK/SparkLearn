# EditorConfig 配置文件
# https://editorconfig.org

# 顶级配置
root = true

# 默认配置
[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown 文件
[*.md]
trim_trailing_whitespace = false

# Windows 批处理文件
[*.bat]
end_of_line = crlf

# Shell 脚本
[*.sh]
end_of_line = lf

# TypeScript 文件
[*.ts]
indent_size = 2

# JavaScript 文件
[*.js]
indent_size = 2

# SCSS 文件
[*.scss]
indent_size = 2

# JSON 文件
[*.json]
indent_size = 2

# YAML 文件
[*.{yml,yaml}]
indent_size = 2

{
  "manifest_version": 3,
  "name": "SparkLearn 网页资料采集",
  "version": "0.1.0",
  "description": "抓取当前网页正文，保存到 SparkLearn 我的资料并生成 AI 解析。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*", "<all_urls>"],
  "action": {
    "default_title": "保存到 SparkLearn",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
